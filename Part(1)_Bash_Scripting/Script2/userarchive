#!/bin/bash

x="./program"

y=$USER


numbers="main.c main.h hello.c hello.h"


	if [ "$USER" = "root" ]; then


if [ -d "$x" ]; then

rm -r "$x"

fi

mkdir "$x"

touch "$x/main.c" "$x/main.h" "$x/hello.c" "$x/hello.h"

for num in $numbers;  do

